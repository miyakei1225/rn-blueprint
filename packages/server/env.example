# ローカル開発用の環境変数。このファイルを .env にコピーして値を設定する。
# .env は .gitignore に含まれているのでコミットしない。

# --- アプリケーション ---
NODE_ENV=development
PORT=3000

# Swagger UI の表示。NODE_ENV が production でなければ既定で有効になる。
# 明示的に制御したい場合のみ指定する。
# DOCS_ENABLED=true

# --- データベース ---
# compose.yaml と合わせた既定値を設定している。
DB_USER=app
DB_PASSWORD=password
DB_NAME=blueprint
DB_HOST=localhost
DB_PORT=5432
DB_MAX_POOL_SIZE=5

# Cloud Run 環境では INSTANCE_CONNECTION_NAME を設定する（DB_HOST より優先される）。
# 例: your-project:asia-northeast1:your-instance
# INSTANCE_CONNECTION_NAME=
