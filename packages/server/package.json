{
  "name": "@rn-blueprint/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:seed": "docker compose exec -T postgres psql -U app -d blueprint -f /db/seed.sql",
    "generate:schema": "kysely-codegen --dialect postgres --out-file src/infra/db/schema.ts --url \"${DATABASE_URL:-postgres://app:password@localhost:5432/blueprint}\"",
    "deploy:dev": "./deploy.sh dev",
    "deploy:prd": "./deploy.sh prd"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "0.6.1",
    "hono": "4.13.2",
    "kysely": "0.29.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "typescript": "5.9.3"
  }
}
