{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // node が TS を直接実行する (`pnpm dev`) 際、import 指定子は実在するパスでなければ
    // 解決できない。ソースでは ./foo.ts と書き、tsc の出力では ./foo.js に書き換える。
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
