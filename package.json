{
  "name": "rn-blueprint",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "pnpm --filter @rn-blueprint/mobile start",
    "ios": "pnpm --filter @rn-blueprint/mobile ios",
    "android": "pnpm --filter @rn-blueprint/mobile android",
    "web": "pnpm --filter @rn-blueprint/mobile web",
    "dev:server": "pnpm --filter @rn-blueprint/server dev",
    "generate:openapi": "pnpm --filter @rn-blueprint/api-spec generate:openapi",
    "generate:api": "pnpm generate:openapi && pnpm --filter @rn-blueprint/mobile generate:api",
    "lint": "pnpm --filter @rn-blueprint/api-spec lint && pnpm --filter @rn-blueprint/mobile lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typespec/prettier-plugin-typespec": "1.15.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.5.14"
  }
}
